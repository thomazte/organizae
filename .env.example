# Credenciais do Supabase (login + sincronização em nuvem).
# Copie este arquivo para ".env" e preencha com os valores do seu projeto.
# Encontre em: Supabase > Project Settings > API.
#
# Sem estas variáveis, o app funciona normalmente em modo 100% local.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
